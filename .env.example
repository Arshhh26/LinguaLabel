# LinguaLabel Environment Configuration Template
# Copy this file to .env and configure your secrets before running the application.

# Application Environment: 'development', 'testing', or 'production'
APPLICATION_ENV=production

# Database Connection:
# SQLite (default for single-node / local evaluation):
DATABASE_URL=sqlite:///lingualabel_local.db
# PostgreSQL (recommended for production scale with high concurrency):
# DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/lingualabel_db

# Private Owner Authentication Key (Required, minimum 32 characters)
# Protects the private Owner Analytics & Continuous Training Center.
# Generate with: openssl rand -hex 32
LINGUALABEL_ADMIN_KEY=replace_with_a_secure_random_key_of_at_least_32_characters

# Session Cryptographic Key (Required, minimum 32 characters)
# Used for internal cryptographic signing.
# Generate with: openssl rand -hex 32
AUTH_SECRET_KEY=replace_with_a_secure_random_key_of_at_least_32_characters

# Session Inactivity Timeout (in minutes, default: 120)
SESSION_EXPIRATION_MINUTES=120
