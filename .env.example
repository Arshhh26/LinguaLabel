# LinguaLabel Environment Configuration
# Copy this file to .env and configure your secrets

# Application Environment: 'development', 'testing', or 'production'
APPLICATION_ENV=development

# Database URL:
# Primary Production: PostgreSQL with psycopg driver
# Example: postgresql+psycopg://username:password@localhost:5432/lingualabel_db
# Local Development / Fallback Default: SQLite file
DATABASE_URL=sqlite:///lingualabel_local.db

# Authentication Secret Key for session signing and cryptographic validation
# In production, generate a secure random 32-byte secret (e.g. `openssl rand -hex 32`)
AUTH_SECRET_KEY=lingualabel-dev-secret-replace-with-random-hex-in-production-2026

# Session Security & Inactivity Timeout (in minutes, default: 120)
SESSION_EXPIRATION_MINUTES=120

